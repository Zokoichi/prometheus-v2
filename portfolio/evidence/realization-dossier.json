                                  "content":  "{\n  \"schema_version\": \"1.0\",\n  \"profile_id\": \"PROM-V2-SHORT-V1\",\n  \"description\": \"Canonical production profile for vertical short-form video.\",\n  \"delivery\": {\n    \"width\": 1080,\n    \"height\": 1920,\n    \"orientation\": \"VERTICAL\",\n    \"pixel_format\": \"yuv420p\",\n    \"video_codec\": \"H264\",\n    \"audio_codec\": \"AAC\",\n    \"audio_sample_rate_hz\": 48000,\n    \"audio_channels\": 2,\n    \"container\": \"MP4\",\n    \"default_fps\": 30,\n    \"duration_min_seconds\": 15,\n    \"duration_max_seconds\": 180\n  },\n  \"audio_master\": {\n    \"loudness_standard\": \"EBU_R128\",\n    \"target_integrated_lufs\": -14.0,\n    \"max_true_peak_dbtp\": -1.0,\n    \"target_lra_lu\": 11.0,\n    \"voice_priority\": true,\n    \"music_ducking_db\": 8.0,\n    \"sfx_ducking_db\": 3.0\n  },\n  \"timeline\": {\n    \"timebase\": \"SECONDS\",\n    \"minimum_segment_duration_seconds\": 0.10,\n    \"minimum_visual_duration_seconds\": 0.20,\n    \"minimum_caption_duration_seconds\": 0.20,\n    \"maximum_caption_line_count\": 2\n  },\n  \"quality\": {\n    \"require_video_stream\": true,\n    \"require_audio_stream\": true,\n    \"require_valid_mp4\": true,\n    \"require_a_v_duration_tolerance_seconds\": 0.10,\n    \"require_no_clipping\": true,\n    \"require_caption_safe_area\": true,\n    \"require_artifact_registry\": true,\n    \"require_sha256\": true\n  },\n  \"render\": {\n    \"engine\": \"FFMPEG\",\n    \"audio_normalization_filter\": \"loudnorm\",\n    \"normalization_mode\": \"TWO_PASS\",\n    \"hardware_acceleration\": \"NONE\",\n    \"deterministic_render\": true\n  }\n}\r\n",
