                                  "content":  "Timing is off.\n============================================================\nPROMETHEUS V2 - 11-F.3-A LOCK / CONCURRENCY FORENSICS\nREAD-ONLY\n============================================================\nBEGIN\n\n============================================================\n01. PRIMITIVE INVENTORY\n============================================================\n         function_name          |                                                                                                                                                                                                                                                    arguments                                                                                                                                                                                                                                                    \n--------------------------------+-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------\n claim_stage_for_execution      | p_stage_id character varying\n complete_stage_atomically      | p_stage_id character varying, p_event_data jsonb\n fail_run_atomically            | p_run_id character varying, p_stage_id character varying, p_event_type character varying, p_event_data jsonb\n fail_stage_atomically          | p_stage_id character varying, p_error_code character varying, p_error_message text, p_event_data jsonb\n record_execution_event         | p_event_id character varying, p_run_id character varying, p_stage_id character varying, p_stage_name character varying, p_attempt integer, p_event_type character varying, p_provider character varying, p_executor_type character varying, p_status character varying, p_started_at timestamp with time zone, p_completed_at timestamp with time zone, p_duration_ms bigint, p_error_code character varying, p_error_message text, p_input_artifact_ids jsonb, p_output_artifact_ids jsonb, p_event_data jsonb\n validate_run_stage_consistency | p_run_id character varying\n validate_stage_artifacts       | p_stage_id character varying\n(7 rows)\n\n\n============================================================\n02. CLAIM SOURCE\n============================================================\n                                                                              pg_get_functiondef                                                                              \n------------------------------------------------------------------------------------------------------------------------------------------------------------------------------\n CREATE OR REPLACE FUNCTION public.claim_stage_for_execution(p_stage_id character varying)                                                                                   +\n  RETURNS TABLE(claimed boolean, stage_id character varying, run_id character varying, stage_name character varying, attempt integer, status character varying, message text)+\n  LANGUAGE plpgsql                                                                                                                                                           +\n AS $function$                                                                                                                                                               +\n DECLARE                                                                                                                                                                     +\n     v_run_id VARCHAR(64);                                                                                                                                                   +\n     v_current_status VARCHAR(32);                                                                                                                                           +\n     v_current_attempt INTEGER;                                                                                                                                              +\n     v_current_retryable BOOLEAN;                                                                                                                                            +\n     v_stage_name VARCHAR(64);                                                                                                                                               +\n                                                                                                                                                                             +\n     v_blocked_count INTEGER;                                                                                                                                                +\n     v_blocked_ids TEXT;                                                                                                                                                     +\n     v_blocked_statuses TEXT;                                                                                                                                                +\n BEGIN                                                                                                                                                                       +\n                                                                                                                                                                             +\n     /*                                                                                                                                                                      +\n      * ------------------------------------------------------------                                                                                                         +\n      * 1. Lire et verrouiller la cible.                                                                                                                                     +\n      * ------------------------------------------------------------                                                                                                         +\n      */                                                                                                                                                                     +\n     SELECT                                                                                                                                                                  +\n         ps.run_id,                                                                                                                                                          +\n         ps.status,                                                                                                                                                          +\n         ps.attempt,                                                                                                                                                         +\n         ps.retryable,                                                                                                                                                       +\n         ps.stage_name                                                                                                                                                       +\n     INTO                                                                                                                                                                    +\n         v_run_id,                                                                                                                                                           +\n         v_current_status,                                                                                                                                                   +\n         v_current_attempt,                                                                                                                                                  +\n         v_current_retryable,                                                                                                                                                +\n         v_stage_name                                                                                                                                                        +\n     FROM production_stage ps                                                                                                                                                +\n     WHERE ps.stage_id = p_stage_id                                                                                                                                          +\n     FOR UPDATE;                                                                                                                                                             +\n                                                                                                                                                                             +\n     IF NOT FOUND THEN                                                                                                                                                       +\n         RETURN QUERY                                                                                                                                                        +\n         SELECT                                                                                                                                                              +\n             FALSE,                                                                                                                                                          +\n             p_stage_id,                                                                                                                                                     +\n             NULL::VARCHAR(64),                                                                                                                                              +\n             NULL::VARCHAR(64),                                                                                                                                              +\n             NULL::INTEGER,                                                                                                                                                  +\n             NULL::VARCHAR(32),                                                                                                                                              +\n             \u0027Stage inexistant.\u0027::TEXT;                                                                                                                                      +\n                                                                                                                                                                             +\n         RETURN;                                                                                                                                                             +\n     END IF;                                                                                                                                                                 +\n                                                                                                                                                                             +\n                                                                                                                                                                             +\n     /*                                                                                                                                                                      +\n      * ------------------------------------------------------------                                                                                                         +\n      * 2. Vérifier que la cible est actuellement réclamable.                                                                                                                +\n      * ------------------------------------------------------------                                                                                                         +\n      */                                                                                                                                                                     +\n     IF NOT (                                                                                                                                                                +\n         v_current_status = \u0027PENDING\u0027                                                                                                                                        +\n         OR (                                                                                                                                                                +\n             v_current_status = \u0027ERROR\u0027                                                                                                                                      +\n             AND v_current_retryable = TRUE                                                                                                                                  +\n         )                                                                                                                                                                   +\n     ) THEN                                                                                                                                                                  +\n                                                                                                                                                                             +\n         RETURN QUERY                                                                                                                                                        +\n         SELECT                                                                                                                                                              +\n             FALSE,                                                                                                                                                          +\n             p_stage_id,                                                                                                                                                     +\n             v_run_id,                                                                                                                                                       +\n             v_stage_name,                                                                                                                                                   +\n             v_current_attempt,                                                                                                                                              +\n             v_current_status,                                                                                                                                               +\n             (                                                                                                                                                               +\n                 \u0027Stage non réclamable. Etat actuel : \u0027                                                                                                                      +\n                 || v_current_status                                                                                                                                         +\n                 || \u0027, attempt \u0027                                                                                                                                             +\n                 || v_current_attempt                                                                                                                                        +\n                 || \u0027.\u0027                                                                                                                                                      +\n             )::TEXT;                                                                                                                                                        +\n                                                                                                                                                                             +\n         RETURN;                                                                                                                                                             +\n     END IF;                                                                                                                                                                 +\n                                                                                                                                                                             +\n                                                                                                                                                                             +\n     /*                                                                                                                                                                      +\n      * ------------------------------------------------------------                                                                                                         +\n      * 3. Sérialiser les claims d\u0027un même Run.                                                                                                                              +\n      *                                                                                                                                                                      +\n      * Cela évite qu\u0027une structure de dépendances cyclique                                                                                                                  +\n      * historique provoque un deadlock entre deux claims                                                                                                                    +\n      * concurrents.                                                                                                                                                         +\n      * ------------------------------------------------------------                                                                                                         +\n      */                                                                                                                                                                     +\n     PERFORM pg_advisory_xact_lock(                                                                                                                                          +\n         hashtextextended(                                                                                                                                                   +\n             \u0027PROMETHEUS_V2_STAGE_CLAIM:\u0027 || v_run_id,                                                                                                                       +\n             0                                                                                                                                                               +\n         )                                                                                                                                                                   +\n     );                                                                                                                                                                      +\n                                                                                                                                                                             +\n                                                                                                                                                                             +\n     /*                                                                                                                                                                      +\n      * ------------------------------------------------------------                                                                                                         +\n      * 4. Verrouiller toutes les dépendances de la cible                                                                                                                    +\n      *    dans un ordre déterministe.                                                                                                                                       +\n      *                                                                                                                                                                      +\n      * Le verrouillage permet de stabiliser l\u0027état des dépendances                                                                                                          +\n      * pendant toute la décision de claim.                                                                                                                                  +\n      * ------------------------------------------------------------                                                                                                         +\n      */                                                                                                                                                                     +\n     PERFORM 1                                                                                                                                                               +\n     FROM production_stage dep                                                                                                                                               +\n     JOIN production_stage_dependency d                                                                                                                                      +\n         ON d.depends_on_stage_id = dep.stage_id                                                                                                                             +\n     WHERE d.stage_id = p_stage_id                                                                                                                                           +\n     ORDER BY dep.stage_id                                                                                                                                                   +\n     FOR UPDATE;                                                                                                                                                             +\n                                                                                                                                                                             +\n                                                                                                                                                                             +\n     /*                                                                                                                                                                      +\n      * ------------------------------------------------------------                                                                                                         +\n      * 5. Identifier les dépendances SUCCESS non satisfaites.                                                                                                               +\n      *                                                                                                                                                                      +\n      * SUCCESS signifie explicitement :                                                                                                                                     +\n      * dépendance SUCCEEDED.                                                                                                                                                +\n      * ------------------------------------------------------------                                                                                                         +\n      */                                                                                                                                                                     +\n     SELECT                                                                                                                                                                  +\n         COUNT(*),                                                                                                                                                           +\n         STRING_AGG(                                                                                                                                                         +\n             d.depends_on_stage_id,                                                                                                                                          +\n             \u0027, \u0027                                                                                                                                                            +\n             ORDER BY d.depends_on_stage_id                                                                                                                                  +\n         ),                                                                                                                                                                  +\n         STRING_AGG(                                                                                                                                                         +\n             d.depends_on_stage_id                                                                                                                                           +\n             || \u0027=\u0027                                                                                                                                                          +\n             || dep.status,                                                                                                                                                  +\n             \u0027, \u0027                                                                                                                                                            +\n             ORDER BY d.depends_on_stage_id                                                                                                                                  +\n         )                                                                                                                                                                   +\n     INTO                                                                                                                                                                    +\n         v_blocked_count,                                                                                                                                                    +\n         v_blocked_ids,                                                                                                                                                      +\n         v_blocked_statuses                                                                                                                                                  +\n     FROM production_stage_dependency d                                                                                                                                      +\n     JOIN production_stage dep                                                                                                                                               +\n         ON dep.stage_id = d.depends_on_stage_id                                                                                                                             +\n     WHERE d.stage_id = p_stage_id                                                                                                                                           +\n       AND d.dependency_type = \u0027SUCCESS\u0027                                                                                                                                     +\n       AND dep.status \u003c\u003e \u0027SUCCEEDED\u0027;                                                                                                                                        +\n                                 