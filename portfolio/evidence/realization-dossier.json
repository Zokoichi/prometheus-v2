                              {
                                  "family":  "scene-plan",
                                  "source":  "tests/scene-plan-compiler/negative/08-immutability-output.json",
                                  "format":  null,
                                  "size_bytes":  3759,
                                  "sha256":  "73641496B02EDFC11D7318C790803C5972169133AFCAEBBF733CEB56636BD406",
                                  "line_count":  1,
                                  "evidence_status":  "observed",
                                  "content_truncated":  false,
                                  "content":  "{\"compiler\":\"SCENE_PLAN_COMPILER\",\"compiler_version\":\"1.0.0\",\"contract\":\"SCENE_PLAN_OUTPUT\",\"contract_version\":1,\"title\":\"Le paradoxe du grand‑père expliqué en 60 secondes\",\"scene_count\":8,\"total_estimated_duration_seconds\":48,\"scenes\":[{\"scene_number\":1,\"role\":\"hook\",\"voice_over\":\"Si vous voyagez dans le passé et tuez votre grand‑père, comment avez‑vous pu exister ?\",\"visual_description\":\"Un scientifique dans un laboratoire tient un dispositif lumineux; coupe à une rue des années 1940 où il pointe un pistolet vers un homme plus âgé, le visage crispé.\",\"word_count\":15,\"estimated_duration_seconds\":6,\"shot_type\":\"CLOSE_UP\",\"camera_motion\":\"ZOOM_IN\"},{\"scene_number\":2,\"role\":\"context\",\"voice_over\":\"La théorie de la relativité autorise les courbes fermées, mais la logique reste fragile.\",\"visual_description\":\"Plan sur un tableau blanc où l’on écrit E=mc², on trace des arcs de cercle représentant des trajectoires temporelles, puis on zoome sur une annotation « courbes fermées ».\",\"word_count\":14,\"estimated_duration_seconds\":5.6,\"shot_type\":\"WIDE\",\"camera_motion\":\"PAN_LEFT\"},{\"scene_number\":3,\"role\":\"development\",\"voice_over\":\"En détruisant l’ancêtre, vous annulez la chaîne d\\u0027événements qui vous a permis de voyager.\",\"visual_description\":\"Une frise chronologique animée montre une ligne du temps, une flèche recule, puis un X rouge apparaît sur l’image du grand‑père.\",\"word_count\":14,\"estimated_duration_seconds\":5.6,\"shot_type\":\"MEDIUM\",\"camera_motion\":\"ZOOM_IN\"},{\"scene_number\":4,\"role\":\"development\",\"voice_over\":\"Certains physiciens proposent des univers parallèles où chaque action crée une branche séparée.\",\"visual_description\":\"Écran partagé en deux; à gauche le voyageur tue son grand‑père, à droite le même voyageur regarde un monde où le grand‑père vit, chaque côté éclairé différemment.\",\"word_count\":13,\"estimated_duration_seconds\":5.2,\"shot_type\":\"EXTREME_WIDE\",\"camera_motion\":\"STATIC\"},{\"scene_number\":5,\"role\":\"revelation\",\"voice_over\":\"Dans cette vue, votre version tue le grand‑père, mais vous continuez d’exister dans une autre réalité.\",\"visual_description\":\"Le voyageur apparaît dans une forêt, deux versions de lui-même se tiennent l’une à côté de l’autre : l’une armée, l’autre observatrice, avec un effet de lumière séparant les réalités.\",\"word_count\":16,\"estimated_duration_seconds\":6.4,\"shot_type\":\"WIDE\",\"camera_motion\":\"ZOOM_OUT\"},{\"scene_number\":6,\"role\":\"development\",\"voice_over\":\"La conjecture de Novikov impose que les événements du passé se conforment déjà à votre futur.\",\"visual_description\":\"Un chercheur pointe du doigt un diagramme intitulé « Novikov self‑consistency » affiché sur un écran, des équations et des flèches bouclées s’animent.\",\"word_count\":16,\"estimated_duration_seconds\":6.4,\"shot_type\":\"CLOSE_UP\",\"camera_motion\":\"STATIC\"},{\"scene_number\":7,\"role\":\"development\",\"voice_over\":\"Ainsi, vous pourriez seulement influencer le passé de façon à garantir votre naissance, jamais l’inverser.\",\"visual_description\":\"Animation d’une boucle : un bébé naît, grandit, entre dans une machine à voyager, revient au point de naissance, créant un cercle continu.\",\"word_count\":15,\"estimated_duration_seconds\":6,\"shot_type\":\"MEDIUM\",\"camera_motion\":\"PAN_RIGHT\"},{\"scene_number\":8,\"role\":\"conclusion\",\"voice_over\":\"Le voyage temporel reste théorique, mais il révèle les limites de notre logique face aux boucles infinies.\",\"visual_description\":\"Le voyageur sort de la machine, regarde le ciel urbain, sourit pensivement; le cadre se fige et le texte « Paradoxe ? » apparaît.\",\"word_count\":17,\"estimated_duration_seconds\":6.8,\"shot_type\":\"WIDE\",\"camera_motion\":\"STATIC\"}]}",
                                  "interesting_lines":  [
                                                            {
                                                                "line_number":  1,
                                                                "text":  "{\"compiler\":\"SCENE_PLAN_COMPILER\",\"compiler_version\":\"1.0.0\",\"contract\":\"SCENE_PLAN_OUTPUT\",\"contract_version\":1,\"title\":\"Le paradoxe du grand‑père expliqué en 60 secondes\",\"scene_count\":8,\"total_estimated_duration_seconds\":48,\"scenes\":[{\"scene_number\":1,\"role\":\"hook\",\"voice_over\":\"Si vous voyagez dans le passé et tuez votre grand‑père, comment avez‑vous pu exister ?\",\"visual_description\":\"Un scientifique dans un laboratoire tient un dispositif lumineux; coupe à une rue des années 1940 où il pointe un pistolet vers un homme plus âgé, le visage crispé.\",\"word_count\":15,\"estimated_duration_seconds\":6,\"shot_type\":\"CLOSE_UP\",\"camera_motion\":\"ZOOM_IN\"},{\"scene_number\":2,\"role\":\"context\",\"voice_over\":\"La théorie de la relativité autorise les courbes fermées, mais la logique reste fragile.\",\"visual_description\":\"Plan sur un tableau blanc où l’on écrit E=mc², on trace des arcs de cercle représentant des trajectoires temporelles, puis on zoome sur une annotation « courbes fermées ».\",\"word_count\":14,\"estimated_duration_seconds\":5.6,\"shot_type\":\"WIDE\",\"camera_motion\":\"PAN_LEFT\"},{\"scene_number\":3,\"role\":\"development\",\"voice_over\":\"En détruisant l’ancêtre, vous annulez la chaîne d\\u0027événements qui vous a permis de voyager.\",\"visual_description\":\"Une frise chronologique animée montre une ligne du temps, une flèche recule, puis un X rouge apparaît sur l’image du grand‑père.\",\"word_count\":14,\"estimated_duration_seconds\":5.6,\"shot_type\":\"MEDIUM\",\"camera_motion\":\"ZOOM_IN\"},{\"scene_number\":4,\"role\":\"development\",\"voice_over\":\"Certains physiciens proposent des univers parallèles où chaque action crée une branche séparée.\",\"visual_description\":\"Écran partagé en deux; à gauche le voyageur tue son grand‑père, à droite le même voyageur regarde un monde où le grand‑père vit, chaque côté éclairé différemment.\",\"word_count\":13,\"estimated_duration_seconds\":5.2,\"shot_type\":\"EXTREME_WIDE\",\"camera_motion\":\"STATIC\"},{\"scene_number\":5,\"role\":\"revelation\",\"voice_over\":\"Dans cette vue, votre version tue le grand‑père, mais vous continuez d’exister dans une autre réalité.\",\"visual_description\":\"Le voyageur apparaît dans une forêt, deux versions de lui-même se tiennent l’une à côté de l’autre : l’une armée, l’autre observatrice, avec un effet de lumière séparant les réalités.\",\"word_count\":16,\"estimated_duration_seconds\":6.4,\"shot_type\":\"WIDE\",\"camera_motion\":\"ZOOM_OUT\"},{\"scene_number\":6,\"role\":\"development\",\"voice_over\":\"La conjecture de Novikov impose que les événements du passé se conforment déjà à votre futur.\",\"visual_description\":\"Un chercheur pointe du doigt un diagramme intitulé « Novikov self‑consistency » affiché sur un écran, des équations et des flèches bouclées s’animent.\",\"word_count\":16,\"estimated_duration_seconds\":6.4,\"shot_type\":\"CLOSE_UP\",\"camera_motion\":\"STATIC\"},{\"scene_number\":7,\"role\":\"development\",\"voice_over\":\"Ainsi, vous pourriez seulement influencer le passé de façon à garantir votre naissance, jamais l’inverser.\",\"visual_description\":\"Animation d’une boucle : un bébé naît, grandit, entre dans une machine à voyager, revient au point de naissance, créant un cercle continu.\",\"word_count\":15,\"estimated_duration_seconds\":6,\"shot_type\":\"MEDIUM\",\"camera_motion\":\"PAN_RIGHT\"},{\"scene_number\":8,\"role\":\"conclusion\",\"voice_over\":\"Le voyage temporel reste théorique, mais il révèle les limites de notre logique face aux boucles infinies.\",\"visual_description\":\"Le voyageur sort de la machine, regarde le ciel urbain, sourit pensivement; le cadre se fige et le texte « Paradoxe ? » apparaît.\",\"word_count\":17,\"estimated_duration_seconds\":6.8,\"shot_type\":\"WIDE\",\"camera_motion\":\"STATIC\"}]}"
