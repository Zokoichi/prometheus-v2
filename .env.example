# ============================================================
# PROMETHEUS V2 - ENVIRONMENT TEMPLATE
# ============================================================

POSTGRES_IMAGE=postgres:18.6-alpine3.24
N8N_IMAGE=n8nio/n8n:2.37.11

POSTGRES_DB=prometheus_v2
POSTGRES_USER=prometheus
POSTGRES_PASSWORD=CHANGE_ME_PROMETHEUS_DB_PASSWORD

N8N_BASIC_AUTH_ACTIVE=false

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

N8N_RUNNERS_MODE=internal

GENERIC_TIMEZONE=America/Martinique
TZ=America/Martinique
