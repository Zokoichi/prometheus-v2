{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometheus://contracts/editing-blueprint/v1",
  "title": "PROMETHEUS V2 Editing Blueprint",
  "type": "object",
  "required": [
    "version",
    "profile_id",
    "duration_seconds",
    "timeline",
    "audio"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "start_seconds",
          "end_seconds",
          "scene_number",
          "visuals"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scene_number": {
            "type": "integer",
            "minimum": 1
          },
          "visuals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "artifact_id",
                "start_seconds",
                "end_seconds"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string"
                },
                "start_seconds": {
                  "type": "number"
                },
                "end_seconds": {
                  "type": "number"
                },
                "fit_mode": {
                  "type": "string",
                  "enum": [
                    "COVER",
                    "CONTAIN",
                    "STRETCH"
                  ]
                },
                "motion": {
                  "type": "string",
                  "enum": [
                    "STATIC",
                    "PUSH_IN",
                    "PULL_OUT",
                    "PAN_LEFT",
                    "PAN_RIGHT",
                    "PAN_UP",
                    "PAN_DOWN"
                  ]
                },
                "transition_in": {
                  "type": "string",
                  "enum": [
                    "CUT",
                    "FADE",
                    "DISSOLVE",
                    "WIPE"
                  ]
                }
              }
            }
          },
          "caption_segment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sfx": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "artifact_id",
                "start_seconds",
                "gain_db"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string"
                },
                "start_seconds": {
                  "type": "number"
                },
                "gain_db": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "voice_artifacts",
        "music",
        "master"
      ],
      "properties": {
        "voice_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "music": {
          "type": ["object", "null"],
          "properties": {
            "artifact_id": {
              "type": "string"
            },
            "gain_db": {
              "type": "number"
            },
            "ducking_db": {
              "type": "number"
            },
            "loop": {
              "type": "boolean"
            }
          }
        },
        "master": {
          "type": "object",
          "required": [
            "target_lufs",
            "max_true_peak_dbtp"
          ],
          "properties": {
            "target_lufs": {
              "type": "number"
            },
            "max_true_peak_dbtp": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
