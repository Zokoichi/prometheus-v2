{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometheus://contracts/visual-asset/v1",
  "title": "PROMETHEUS V2 Visual Asset",
  "type": "object",
  "required": [
    "artifact_id",
    "media_type",
    "width",
    "height",
    "content_type",
    "duration_seconds"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "type": "string",
      "enum": ["IMAGE", "VIDEO"]
    },
    "content_type": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "fps": {
      "type": ["number", "null"],
      "minimum": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": ["string", "null"]
        },
        "prompt_hash": {
          "type": ["string", "null"]
        }
      }
    },
    "visual_style": {
      "type": "string"
    },
    "license": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
