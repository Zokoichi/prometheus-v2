{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometheus://contracts/sfx-asset/v1",
  "title": "PROMETHEUS V2 SFX Asset",
  "type": "object",
  "required": [
    "artifact_id",
    "content_type",
    "duration_seconds",
    "license"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "enum": ["audio/wav", "audio/mpeg"]
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "IMPACT",
        "WHOOSH",
        "RISER",
        "AMBIENCE",
        "TRANSITION",
        "UI",
        "OTHER"
      ]
    },
    "license": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "proof_artifact_id": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "additionalProperties": true
}
