{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometheus://contracts/voice-output/v1",
  "title": "PROMETHEUS V2 Voice Output",
  "type": "object",
  "required": [
    "artifact_id",
    "voice",
    "provider",
    "content_type",
    "sample_rate_hz",
    "channels",
    "duration_seconds",
    "scene_number",
    "text_sha256"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "voice": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string",
      "enum": ["audio/wav", "audio/mpeg"]
    },
    "sample_rate_hz": {
      "type": "integer",
      "enum": [24000, 44100, 48000]
    },
    "channels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "scene_number": {
      "type": "integer",
      "minimum": 1
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "speech_rate_wpm": {
      "type": "number",
      "minimum": 50,
      "maximum": 300
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
